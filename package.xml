<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format2.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>libxml2_vendor</name>
  <version>0.1.0</version>
  <description>
    Wrapper around libxml2 (GNOME XML library), providing a dependency on libxml2
    if available or building it locally (cross-compiled for VxWorks) if not found.
    Pinned to v2.15.2 to match Ubuntu 26.04 (resolute) libxml2-dev.
  </description>
  <maintainer email="Andrei.Kholodnyi@gmail.com">Andrei Kholodnyi</maintainer>
  <license>Apache License 2.0</license> <!-- the contents of this package are Apache 2.0 -->
  <license>MIT</license>                <!-- libxml2 uses the MIT license -->

  <url type="repository">https://github.com/GNOME/libxml2</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>git</buildtool_depend>

  <depend>libxml2-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
